{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.RobertoHanas/ikuna-mcp",
  "title": "Ikuna",
  "description": "Read workspace context and activity from the running Ikuna macOS app, with app-managed permissions.",
  "version": "0.2.1",
  "websiteUrl": "https://www.npmjs.com/package/ikuna-mcp",
  "repository": {
    "url": "https://github.com/RobertoHanas/ikuna-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "ikuna-mcp",
      "version": "0.2.1",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "-y"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "setup": "Requires macOS, Node.js 18+, and Ikuna running with capabilities enabled in Settings → AI Connections.",
      "mcpServers": {
        "ikuna": {
          "command": "npx",
          "args": [
            "-y",
            "ikuna-mcp"
          ]
        }
      },
      "codexConfig": "[mcp_servers.ikuna]\ncommand = \"npx\"\nargs = [\"-y\", \"ikuna-mcp\"]\nstartup_timeout_sec = 30\n"
    }
  }
}
